{
  "expo": {
    "name": "memory-road",
    "slug": "memory-road",
    "scheme": "memory-road",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Memory Road želi pristupiti tvojoj lokaciji za spremanje uspomena."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Memory Road želi pristupiti kameri za fotografiranje uspomena."
        }
      ],
      "expo-font"
    ]
  }
}
